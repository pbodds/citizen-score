# Citizen Score for Arch and derivatives (CachyOS, Manjaro, EndeavourOS).
#
# Builds from the repository this file sits in, not from a downloaded
# tarball: the release workflow (.github/workflows/release.yml) runs
# `makepkg` in an Arch container, and so can anyone from a checkout:
#
#   cd packaging/arch && makepkg -si
#
# The offline build (no account, uploads or updater), installed to /usr/bin,
# with the game data and bundled plugins where Tauri looks for resources
# (/usr/lib/Citizen Score). The install script grants packet-capture
# permission, so the meter never runs as root (citizen-score.install).

pkgname=citizen-score
pkgver=0
pkgrel=1
pkgdesc="Citizen Score: real-time DPS meter, Pet Map and World Timers for AION 2 (Linux/Proton)"
arch=('x86_64')
url="https://github.com/pbodds/citizen-score"
license=('GPL-3.0-only')
# gst-plugins-base and -good: WebKitGTK plays sound (World Timers' alerts)
# through GStreamer's audioconvert and autoaudiosink, which webkit2gtk-4.1 only
# lists as optional.
depends=('webkit2gtk-4.1' 'gtk3' 'libpcap' 'libcap' 'hicolor-icon-theme' 'gst-plugins-base' 'gst-plugins-good')
makedepends=('rust' 'nodejs' 'npm' 'git' 'pkgconf')
install=citizen-score.install
options=('!lto' '!debug' '!strip')

# The repository root, two levels up from packaging/arch.
_root() {
  cd "$startdir/../.." && pwd
}

# A release (the commit tagged v<version>) is plain <version>; any other
# commit is <version>.r<commits>.g<hash>, which pacman ranks after it.
pkgver() {
  cd "$(_root)"
  local version
  version=$(grep -m1 '^version' src-tauri/Cargo.toml | cut -d'"' -f2)
  if git tag --points-at HEAD | grep -qx "v$version"; then
    printf '%s' "$version"
  else
    printf '%s.r%s.g%s' "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
  fi
}

build() {
  cd "$(_root)"
  # The release workflow packs the binaries its Linux job built
  # (CS_PREBUILT=1) rather than compiling them again.
  if [ -n "${CS_PREBUILT:-}" ] && [ -f src-tauri/target/release/citizen-score ] \
     && [ -f src-tauri/target/release/a2tools-hotkeys ]; then
    return 0
  fi
  # Files a clean checkout lacks (they are gitignored mirrors of src/data).
  mkdir -p public/i18n public/data public/src/data
  cp -r src/data/i18n/* public/i18n/
  cp src/data/skill_icons.json src/data/dot_skill_ids.json public/data/
  cp src/data/skill_icons.json src/data/dot_skill_ids.json public/src/data/
  npm ci
  npx tauri build --no-bundle -- --no-default-features --features desktop
  # The hotkeys helper, run without the meter's capture permission
  # (platform/linux/hotkeys.rs); the .install script gives caps to the meter only.
  cargo build --release --manifest-path src-tauri/Cargo.toml --no-default-features --features desktop --bin a2tools-hotkeys
}

package() {
  local root
  root="$(_root)"
  install -Dm755 "$root/src-tauri/target/release/citizen-score" "$pkgdir/usr/bin/citizen-score"
  install -Dm755 "$root/src-tauri/target/release/a2tools-hotkeys" "$pkgdir/usr/bin/a2tools-hotkeys"

  install -d "$pkgdir/usr/lib/Citizen Score"
  cp -r "$root/src/data" "$pkgdir/usr/lib/Citizen Score/data"
  cp -r "$root/plugins" "$pkgdir/usr/lib/Citizen Score/plugins"
  ln -s "Citizen Score" "$pkgdir/usr/lib/citizen-score"

  install -Dm644 "$root/src-tauri/icons/128x128.png" \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/citizen-score.png"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/citizen-score.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Citizen Score
Comment=Real-time DPS meter for AION 2
Exec=citizen-score
Icon=citizen-score
StartupWMClass=citizen-score
Categories=Game;Utility;
DESKTOP
  install -Dm644 "$root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
